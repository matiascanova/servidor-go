package views

import (
	"fmt"
	"tp2_entrega/db"
)

// EntityForm renderiza el formulario para registrar o editar una reseña sobre una materia
templ EntityForm(materia db.Materia, voto *db.Voto) {
	@Layout(func() string {
		if voto != nil {
			return "Editar reseña de " + materia.Nombre
		}
		return "Calificar " + materia.Nombre
	}()) {
		<section class="form-section">
			if voto != nil {
				<h2>Editar tu reseña para { materia.Nombre }</h2>
			} else {
				<h2>Agregar reseña para { materia.Nombre }</h2>
			}
			<form action="/votos" method="POST">
				<!-- ID de la materia vinculado explícitamente -->
				<input type="hidden" name="idmateria" value={ fmt.Sprintf("%d", materia.Idmateria) }/>
				
				<div class="ratings-row">
					<div class="form-group">
						<label for="puntuacion_dif">Dificultad (1-5):</label>
						if voto != nil && voto.PuntuacionDif.Valid {
							<input type="number" id="puntuacion_dif" name="puntuacion_dif" min="1" max="5" value={ fmt.Sprintf("%d", voto.PuntuacionDif.Int32) } required/>
						} else {
							<input type="number" id="puntuacion_dif" name="puntuacion_dif" min="1" max="5" required/>
						}
					</div>
					<div class="form-group">
						<label for="puntuacion_rel">Relevancia (1-5):</label>
						if voto != nil && voto.PuntuacionRel.Valid {
							<input type="number" id="puntuacion_rel" name="puntuacion_rel" min="1" max="5" value={ fmt.Sprintf("%d", voto.PuntuacionRel.Int32) } required/>
						} else {
							<input type="number" id="puntuacion_rel" name="puntuacion_rel" min="1" max="5" required/>
						}
					</div>
					<div class="form-group">
						<label for="puntuacion_gusto">Gusto Personal (1-5):</label>
						if voto != nil && voto.PuntuacionGusto.Valid {
							<input type="number" id="puntuacion_gusto" name="puntuacion_gusto" min="1" max="5" value={ fmt.Sprintf("%d", voto.PuntuacionGusto.Int32) } required/>
						} else {
							<input type="number" id="puntuacion_gusto" name="puntuacion_gusto" min="1" max="5" required/>
						}
					</div>
				</div>

				<div class="form-group">
					<label for="descripcion">Comentario / Opinión:</label>
					<textarea id="descripcion" name="descripcion" rows="3" placeholder="Escribe tu opinión sobre la cursada...">
						if voto != nil && voto.Descripcion.Valid {
							{ voto.Descripcion.String }
						}
					</textarea>
				</div>

				<button type="submit" class="btn-submit">
					if voto != nil {
						Guardar Cambios
					} else {
						Guardar Reseña
					}
				</button>
			</form>
		</section>
	}
}