package views

// RegistroPage muestra el formulario de alta de cuenta. Si el registro falla se
// vuelve a mostrar con lo escrito (menos las contraseñas) y el mensaje de error.
templ RegistroPage(f RegistroForm, errMsg string) {
	@Layout("Crear cuenta") {
		<section class="form-section auth-section">
			<h2>Crear cuenta</h2>
			if errMsg != "" {
				<p class="error-msg" role="alert">{ errMsg }</p>
			}
			<form method="post" action="/registro" class="auth-form">
				<div class="form-group">
					<label for="nombre">Nombre:</label>
					<input type="text" id="nombre" name="nombre" value={ f.Nombre } maxlength="50" required autocomplete="given-name"/>
				</div>
				<div class="form-group">
					<label for="apellido">Apellido:</label>
					<input type="text" id="apellido" name="apellido" value={ f.Apellido } maxlength="50" required autocomplete="family-name"/>
				</div>
				<div class="form-group">
					<label for="email">Email:</label>
					<input type="email" id="email" name="email" value={ f.Email } maxlength="120" required autocomplete="username"/>
				</div>
				<div class="form-group">
					<label for="password">Contraseña (mínimo 8 caracteres):</label>
					<input type="password" id="password" name="password" minlength="8" maxlength="128" required autocomplete="new-password"/>
				</div>
				<div class="form-group">
					<label for="password2">Repetir contraseña:</label>
					<input type="password" id="password2" name="password2" minlength="8" maxlength="128" required autocomplete="new-password"/>
				</div>
				<button type="submit" class="btn-submit">Crear cuenta</button>
			</form>
			<p class="auth-alt">¿Ya tenés cuenta? <a href="/login">Ingresá</a></p>
		</section>
	}
}
